<?xml version="1.0" encoding="UTF-8"?>
<robot name="motor_rex_cell">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="robotiq_85_left_knuckle_joint"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-0.8"/>
    <joint name="elbow_joint" value="1.25"/>
    <joint name="wrist_1_joint" value="-0.45"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="inspection_pose" group="arm">
    <joint name="shoulder_pan_joint" value="-0.2"/>
    <joint name="shoulder_lift_joint" value="-0.95"/>
    <joint name="elbow_joint" value="1.35"/>
    <joint name="wrist_1_joint" value="-0.25"/>
    <joint name="wrist_2_joint" value="0.15"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="pickup_pose" group="arm">
    <joint name="shoulder_pan_joint" value="0.15"/>
    <joint name="shoulder_lift_joint" value="-1.05"/>
    <joint name="elbow_joint" value="1.55"/>
    <joint name="wrist_1_joint" value="-0.35"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="reuse_bin_pose" group="arm">
    <joint name="shoulder_pan_joint" value="-1.45"/>
    <joint name="shoulder_lift_joint" value="-0.75"/>
    <joint name="elbow_joint" value="1.1"/>
    <joint name="wrist_1_joint" value="-0.3"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="repair_bin_pose" group="arm">
    <joint name="shoulder_pan_joint" value="-1.75"/>
    <joint name="shoulder_lift_joint" value="-0.75"/>
    <joint name="elbow_joint" value="1.15"/>
    <joint name="wrist_1_joint" value="-0.3"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="replace_bin_pose" group="arm">
    <joint name="shoulder_pan_joint" value="-2.05"/>
    <joint name="shoulder_lift_joint" value="-0.75"/>
    <joint name="elbow_joint" value="1.15"/>
    <joint name="wrist_1_joint" value="-0.3"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="recycle_bin_pose" group="arm">
    <joint name="shoulder_pan_joint" value="-2.35"/>
    <joint name="shoulder_lift_joint" value="-0.75"/>
    <joint name="elbow_joint" value="1.15"/>
    <joint name="wrist_1_joint" value="-0.3"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.7929"/>
  </group_state>

  <end_effector name="parallel_gripper" parent_link="tool0" group="gripper"/>

  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Internal mechanism"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Internal mechanism"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Internal mechanism"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_left_inner_knuckle_link" reason="Internal mechanism"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Internal mechanism"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="robotiq_85_right_inner_knuckle_link" reason="Internal mechanism"/>
  <disable_collisions link1="forearm_link" link2="wrist_3_link" reason="Simplified wrist envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_base_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_left_knuckle_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_left_inner_knuckle_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_left_finger_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_left_finger_tip_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_right_knuckle_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_right_inner_knuckle_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_right_finger_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="forearm_link" link2="robotiq_85_right_finger_tip_link" reason="Simplified gripper envelope"/>
  <disable_collisions link1="arm_a_pedestal" link2="base_link_inertia" reason="Robot mounting interface"/>
  <disable_collisions link1="arm_a_pedestal" link2="floor" reason="Pedestal rests on floor"/>

  <!-- Table contact is intentional during top-down pickup and placement. -->
  <disable_collisions link1="recovery_table" link2="forearm_link" reason="MVP tabletop approach clearance"/>
  <disable_collisions link1="recovery_table" link2="wrist_1_link" reason="MVP tabletop approach clearance"/>
  <disable_collisions link1="recovery_table" link2="wrist_2_link" reason="MVP tabletop approach clearance"/>
  <disable_collisions link1="recovery_table" link2="wrist_3_link" reason="MVP tabletop approach clearance"/>
  <disable_collisions link1="recovery_table" link2="tool0" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_base_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_left_knuckle_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_left_inner_knuckle_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_left_finger_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_left_finger_tip_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_right_knuckle_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_right_inner_knuckle_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_right_finger_link" reason="Intentional tabletop grasp"/>
  <disable_collisions link1="recovery_table" link2="robotiq_85_right_finger_tip_link" reason="Intentional tabletop grasp"/>
</robot>
