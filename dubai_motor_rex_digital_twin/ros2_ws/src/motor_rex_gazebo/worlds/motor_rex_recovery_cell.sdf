<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="motor_rex_recovery_cell">
    <physics name="dart_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.45 0.48 0.50 1</ambient>
      <background>0.78 0.84 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="operator_recovery_cell_camera">
        <pose>2.2 -2.3 1.65 0 0.58 2.35</pose>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="main_area_light" type="directional">
      <pose>-1 -1 4 0 0 0</pose>
      <diffuse>0.85 0.86 0.84 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 0.4 -1.0</direction>
    </light>

    <light name="inspection_light" type="point">
      <pose>0.6 -0.4 2.0 0 0 0</pose>
      <diffuse>1.0 0.96 0.86 1</diffuse>
      <specular>0.7 0.65 0.55 1</specular>
      <attenuation>
        <range>4</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
  </world>
</sdf>
